{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {
      "expr": "'Monthly Average Locations of ' + selectedBird + \"'s Sightings\""
    },
    "anchor": "middle",
    "offset": 10
  },
  "params": [
    {
      "name": "selectedBird",
      "value": "Rainbow Bee-eater",
      "bind": {
        "input": "select",
        "options": [
          "Rainbow Bee-eater",
          "Eastern Koel",
          "Swift Parrot",
          "Eastern Curlew",
          "Dollarbird",
          "Channel-billed Cuckoo",
          "Budgerigar",
          "Grey Fantail"
        ],
        "name": "Select a bird: "
      }
    },
    {
      "name": "selectedMonth",
      "value": 1
    }
  ],
  "width": "container",
  "height": 260,
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {
    "type": "equirectangular",
    "center": [145, -20],
    "scale": 1200
  },
  "layer": [
    {
      "data": {
        "url": "../data/aus_states.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#FFFDF0",
        "stroke": "darkgrey",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {"url": "../data/centroids.csv"},
      "transform": [
        {"filter": "datum.species === selectedBird"},
        {"calculate": "toNumber(datum.lon)", "as": "lon"},
        {"calculate": "toNumber(datum.lat)", "as": "lat"},
        {"calculate": "toNumber(datum.month)", "as": "month"},
        {
          "calculate": "timeFormat(datetime(2000, datum.month - 1, 1), '%b')",
          "as": "monthName"
        }
      ],
      "layer": [
        {
          "description": "Path joining the monthly locations",
          "mark": {
            "type": "line",
            "strokeWidth": 2.5,
            "color": "#253D32",
            "opacity": 0.9
          },
          "encoding": {
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude": {"field": "lon", "type": "quantitative"},
            "order": {"field": "month", "type": "quantitative"}
          }
        },
        {
          "description": "Direction arrows at the midpoint of each month-to-month segment",
          "transform": [
            {
              "window": [
                {"op": "lead", "field": "lon", "as": "nextLon"},
                {"op": "lead", "field": "lat", "as": "nextLat"}
              ],
              "sort": [{"field": "month", "order": "ascending"}]
            },
            {"filter": "isValid(datum.nextLon) && isValid(datum.nextLat)"},
            {"calculate": "datum.nextLon - datum.lon", "as": "deltaLon"},
            {"calculate": "datum.nextLat - datum.lat", "as": "deltaLat"},
            {
              "calculate": "atan2(-datum.deltaLat, datum.deltaLon) * 180 / PI + 90",
              "as": "angle"
            },
            {"calculate": "(datum.lon + datum.nextLon) / 2", "as": "midLon"},
            {"calculate": "(datum.lat + datum.nextLat) / 2", "as": "midLat"}
          ],
          "mark": {
            "type": "point",
            "shape": "triangle",
            "filled": true,
            "size": 80,
            "color": "#253D32"
          },
          "encoding": {
            "longitude": {"field": "midLon", "type": "quantitative"},
            "latitude": {"field": "midLat", "type": "quantitative"},
            "angle": {"field": "angle", "type": "quantitative", "scale": null}
          }
        },
        {
          "description": "Monthly location markers (selected month highlighted)",
          "mark": {"type": "circle", "size": 140, "filled": true},
          "encoding": {
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude": {"field": "lon", "type": "quantitative"},
            "color": {
              "condition": {
                "test": "datum.month == selectedMonth",
                "value": "#B7410E"
              },
              "value": "#888888"
            },
            "opacity": {"value": 0.85},
            "tooltip": [
              {"field": "species", "type": "nominal", "title": "Bird"},
              {"field": "monthName", "type": "nominal", "title": "Month"},
              {
                "field": "n",
                "type": "quantitative",
                "title": "Recorded sightings",
                "format": ","
              },
              {
                "field": "lat",
                "type": "quantitative",
                "title": "Latitude",
                "format": ".2f"
              },
              {
                "field": "lon",
                "type": "quantitative",
                "title": "Longitude",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "description": "Outlined marker for the selected month",
          "transform": [{"filter": "datum.month === selectedMonth"}],
          "mark": {
            "type": "circle",
            "size": 140,
            "filled": true,
            "stroke": "#B7410E",
            "strokeWidth": 2.5,
            "color": "#E76F35",
            "opacity": 1
          },
          "encoding": {
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude": {"field": "lon", "type": "quantitative"},
            "tooltip": [
              {"field": "species", "type": "nominal", "title": "Bird"},
              {"field": "monthName", "type": "nominal", "title": "Selected month"},
              {
                "field": "n",
                "type": "quantitative",
                "title": "Recorded sightings",
                "format": ","
              }
            ]
          }
        },
        {
          "description": "Label for the selected month",
          "transform": [{"filter": "datum.month === selectedMonth"}],
          "mark": {
            "type": "text",
            "dx": 15,
            "dy": -10,
            "align": "center",
            "baseline": "bottom",
            "font": "Open Sans",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#B7410E"
          },
          "encoding": {
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude": {"field": "lon", "type": "quantitative"},
            "text": {"field": "monthName", "type": "nominal"}
          }
        }
      ]
    }
  ],
  "config": {
    "background": "#FFFFE0",
    "font": "Open Sans",
    "view": {"stroke": null},
    "title": {
      "font": "Inter",
      "fontSize": 18,
      "fontWeight": 600
    },
    "axis": {
      "labelFont": "Open Sans",
      "titleFont": "Open Sans"
    },
    "legend": {
      "titleFont": "Open Sans",
      "labelFont": "Open Sans",
      "titleFontSize": 11,
      "labelFontSize": 10,
      "titleColor": "#253D32",
      "labelColor": "#303632"
    }
  }
}