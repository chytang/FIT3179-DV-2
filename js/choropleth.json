
{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Bird Sightings by State, 2019-2025",
    "params": [
        {
            "name": "chosen",
            "value": "Total Sightings",
            "bind": {
                "input": "select",
                "options": ["Total Sightings","Sightings Per Person"],
                "name": "Display: "
            }
        }
    ],
    "width": "container",
    "height": 500,
    "padding": {"left": 0, "right": 10, "top": 5, "bottom": 0},
    "autosize": {"type": "fit", "contains": "padding"},
    "projection": {
        "type": "conicEqualArea",
        "parallels": [-18, -36],
        "rotate": [-134, 0],
        "center": [-1, -28],
        "scale": { "expr": "min(width / 0.6, height / 0.6) * 0.96" },
        "translate": { "expr": "[width / 2, height / 2]" }
    },
    "data": {
        "url": "../data/aus_states.topojson",
        "format": {
            "type": "topojson",
            "feature": "states"
        }
    },
    "transform": [
        {
            "lookup": "properties.STE_NAME21",
            "from": {
                "data": {"url": "../data/state_totals.csv"},
                "key": "state",
                "fields": ["sightings"]
            }
        },
        {
            "lookup": "properties.STE_NAME21",
            "from": {
                "data": {"url": "../data/state_population.csv"},
                "key": "state",
                "fields": ["population"]
            }
        },
        {
            "calculate": "datum.sightings / datum.population",
            "as": "perPerson"
        }
    ],
    "layer": [
        {
            "transform": [
                {"filter": "chosen === 'Total Sightings'"}
            ],
            "mark": {
                "type": "geoshape",
                "stroke": "darkgrey",
                "strokeWidth": 1
            },
            "encoding": {
                "color": {
                    "field": "sightings",
                    "type": "quantitative",
                    "scale": {
                        "type": "linear",
                        "scheme": "oranges",
                        "domain": [0, 15000000]
                    },
                    "legend": {
                        "title": "Total Sightings",
                        "titleFontSize": 12,
                        "orient": "right",
                        "offset": -10,
                        "values": [0, 5000000, 10000000, 15000000],
                        "format": "~s"
                    }
                },
                "tooltip": [
                    {
                        "field": "properties.STE_NAME21",
                        "type": "nominal",
                        "title": "State"
                    },
                    {
                        "field": "sightings",
                        "type": "quantitative",
                        "title": "Total sightings",
                        "format": ","
                    },
                    {
                        "field": "population",
                        "type": "quantitative",
                        "title": "State population",
                        "format": ","
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "chosen === 'Sightings Per Person'"
                }
            ],
            "mark": {
                "type": "geoshape",
                "stroke": "darkgrey",
                "strokeWidth": 1
            },
            "encoding": {
                "color": {
                    "field": "perPerson",
                    "type": "quantitative",
                    "scale": {
                        "type": "threshold",
                        "domain": [0, 1, 2, 3, 4, 5, 6, 7, 8],
                        "range": ["#f7fcf5", "#e5f5e0", "#c7e9c0", "#a1d99b",
                                  "#74c476", "#41ab5d", "#238b45", "#006d2c", "#00441b", "#002b16"]
                    },
                    "legend": {
                        "title": "Sightings Per Person",
                        "titleFontSize": 12,
                        "orient": "right",
                        "offset": -10
                    }
                },
                "tooltip": [
                    {
                        "field": "properties.STE_NAME21",
                        "type": "nominal",
                        "title": "State"
                    },
                    {
                        "field": "perPerson",
                        "type": "quantitative",
                        "title": "Sightings per person",
                        "format": ".2f"
                    },
                    {
                        "field": "population",
                        "type": "quantitative",
                        "title": "State population",
                        "format": ","
                    },
                    {
                        "field": "sightings",
                        "type": "quantitative",
                        "title": "Total sightings",
                        "format": ","
                    }
                ]
            }
        }
    ],
    "config": {
        "background": "#FFFFE0",
        "font": "Open Sans",
        "view": {
            "stroke": null,
            "fill": "#FFFFE0"
        },
        "title": {
            "font": "Inter",
            "fontSize": 18,
            "fontWeight": 600,
            "anchor": "middle",
            "color": "black"
        },
        "legend": {
            "titleFont": "Open Sans",
            "labelFont": "Open Sans",
            "titleFontSize": 12,
            "labelFontSize": 11
        }
    }
}
