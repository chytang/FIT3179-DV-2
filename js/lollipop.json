
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Change in Sightings by Bird, 2019-2025",
    "anchor": "middle",
    "offset": 12
  },
  "params": [
    {"name": "selectedBird", "value": "Australian Magpie"}
  ],
  "width": 460,
  "height": 500,
  "padding": {"left": 0, "right": 20, "top": 5, "bottom": 5},
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {"url": "../data/top_species_by_year.csv"},
  "transform": [
    {"filter": "datum.year == 2019 || datum.year == 2025"},
    {"calculate": "datum.year == 2019 ? datum.count : 0", "as": "startCount"},
    {"calculate": "datum.year == 2025 ? datum.count : 0", "as": "endCount"},
    {
      "aggregate": [
        {"op": "sum", "field": "startCount", "as": "startCount"},
        {"op": "sum", "field": "endCount", "as": "endCount"}
      ],
      "groupby": ["species"]
    },
    {"filter": "datum.startCount > 0 && datum.endCount > 0"},
    {"calculate": "(datum.endCount / datum.startCount - 1) * 100", "as": "pctChange"},
    {"calculate": "(datum.pctChange >= 0 ? '+' : '') + format(datum.pctChange, '.1f') + '%'", "as": "label"}
  ],
  "encoding": {
    "y": {
      "field": "species",
      "type": "nominal",
      "sort": {"field": "pctChange", "op": "max", "order": "descending"},
      "axis": {"title": null}
    },
    "x": {
      "field": "pctChange",
      "type": "quantitative",
      "scale": {"zero": true, "nice": true},
      "axis": {
        "title": "Change in recorded sightings",
        "labelExpr": "(datum.value > 0 ? '+' : '') + datum.value + '%'",
        "grid": true,
        "gridColor": {"condition": {"test": "datum.value === 0", "value": "#303632"}, "value": "#e5e3c9"},
        "gridWidth": {"condition": {"test": "datum.value === 0", "value": 1.5}, "value": 1}
      }
    },
    "tooltip": [
      {"field": "species", "type": "nominal", "title": "Bird"},
      {"field": "startCount", "type": "quantitative", "title": "Sightings in 2019", "format": ","},
      {"field": "endCount", "type": "quantitative", "title": "Sightings in 2025", "format": ","},
      {"field": "label", "type": "nominal", "title": "Percentage change"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2.5},
      "encoding": {
        "x2": {"datum": 0},
        "color": {"condition": {"test": "datum.species === selectedBird", "value": "#6FAE8A"}, "value": "#253D32"}
      }
    },
    {
      "mark": {"type": "circle", "opacity": 1},
      "encoding": {
        "size": {"condition": {"test": "datum.species === selectedBird", "value": 260}, "value": 170},
        "color": {"condition": {"test": "datum.species === selectedBird", "value": "#6FAE8A"}, "value": "#253D32"}
      }
    },
    {
      "transform": [{"filter": "datum.pctChange >= 0"}],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 11, "color": "#303632", "clip": false},
      "encoding": {"text": {"field": "label", "type": "nominal"}}
    },
    {
      "transform": [{"filter": "datum.pctChange < 0"}],
      "mark": {"type": "text", "align": "right", "dx": -8, "fontSize": 11, "color": "#303632", "clip": false},
      "encoding": {"text": {"field": "label", "type": "nominal"}}
    }
  ],
  "config": {
    "background": "#FFFFE0",
    "font": "Open Sans",
    "view": {"stroke": null},
    "title": {"font": "Inter", "fontSize": 18, "fontWeight": 600, "color": "black"},
    "axis": {"grid": false, "ticks": false, "domain": false, "labelFont": "Open Sans", "labelFontSize": 11, "labelColor": "#303632", "labelPadding": 6, "titleFont": "Open Sans", "titleFontSize": 12, "titleFontWeight": 600, "titleColor": "black"}
  }
}
